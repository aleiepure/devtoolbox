using Gtk 4.0;
using Adw 1;

template $ImageArea: Adw.Bin {
    Box {
        margin-top: 10;
        orientation: vertical;
        spacing: 6;

        // MARK: Header
        Box {
            orientation: horizontal;
            halign: fill;
            hexpand: true;
            spacing: 6;

            // Title
            Label _title_label {
                margin-bottom: 8;
                margin-top: 8;
                margin-start: 8;

                styles [
                    "heading",
                ]

                label: bind template.title;
            }

            MenuButton error_icon {
                visible: bind template.error;
                icon-name: "warning-outline";
                tooltip-text: _("Errors present. Click for details.");
                direction: right;

                popover: Popover {
                    position: right;

                    child: Label {
                        label: bind template.error-label;
                        wrap: true;
                        margin-top: 6;
                        margin-bottom: 6;
                        margin-start: 6;
                        margin-end: 6;
                    };
                };

                styles [
                    "flat",
                    "error",
                ]
            }

            // Toolbar
            Box {
                orientation: horizontal;
                halign: end;
                hexpand: true;

                // Loading spinner
                Adw.Spinner loading_spinner {
                    width-request: 16;
                    visible: bind template.working;
                }

                Separator {
                    styles [
                        "spacer",
                    ]

                    visible: bind template.working;
                }

                // Action button
                Button _action_button {
                    styles [
                        "accent",
                    ]

                    label: bind template.action-button-label;
                    visible: bind template.action-button-visible;
                    sensitive: bind template.working inverted;
                    clicked => $on_signal_clicked_action_button() swapped;
                }

                Separator {
                    styles [
                        "spacer",
                    ]

                    visible: bind template.action-button-visible;
                }

                // Edit buttons
                Box {
                    orientation: horizontal;
                    margin-start: 8;
                    spacing: 6;

                    // Open
                    Button open_button {
                        valign: center;
                        visible: bind template.open_button_visible;
                        sensitive: bind template.working inverted;

                        styles [
                            "flat",
                        ]

                        child: Adw.ButtonContent {
                            icon-name: "document-open";
                            label: _("Open");
                        };

                        clicked => $on_signal_clicked_open_button() swapped;
                    }

                    // Save
                    Button save_button {
                        valign: center;
                        visible: bind template.save_button_visible;
                        sensitive: bind template.working inverted;

                        styles [
                            "flat",
                        ]

                        child: Adw.ButtonContent {
                            icon-name: "floppy";
                            label: _("Save");
                        };

                        clicked => $on_signal_clicked_save_button() swapped;
                    }

                    // View
                    Button view_button {
                        valign: center;
                        visible: bind template.view_button_visible;

                        styles [
                            "flat",
                        ]

                        icon-name: "external-link";
                        tooltip-text: _("View in another application");
                        clicked => $on_signal_clicked_view_button() swapped;
                    }

                    // Clear
                    Button clear_button {
                        valign: center;
                        visible: bind template.clear_button_visible;

                        styles [
                            "flat",
                        ]

                        icon-name: "edit-clear";
                        tooltip-text: _("Clear image");
                        clicked => $on_signal_clicked_clear_button() swapped;
                    }
                }
            }
        }

        // MARK: Image Area
        Adw.ViewStack view_stack {
            styles [
                "card",
            ]

            // Image Area Page
            Adw.ViewStackPage {
                name: "image-area";

                child: ScrolledWindow source_scrolled_window {
                    height-request: bind template.height;

                    child: Overlay {
                        [overlay]
                        Revealer drop_revealer {
                            reveal-child: bind template.dragging;
                            transition-type: crossfade;
                            can-target: false;

                            styles [
                                "rounded-corner",
                            ]

                            child: Adw.StatusPage {
                                styles [
                                    "rounded-corner",
                                    "dnd-highlight",
                                    "compact",
                                    "view",
                                ]

                                title: _("Drop an image file here");
                                icon-name: "document-open";
                            };
                        }

                        Picture picture {
                            can-shrink: true;
                            keep-aspect-ratio: true;
                            content-fit: scale_down;

                            styles ["rounded-corner"]
                        }
                    };
                };
            }

            Adw.ViewStackPage {
                name: "loading";

                child: Box {
                    orientation: vertical;
                    margin-bottom: 3;
                    margin-end: 3;
                    margin-start: 3;
                    margin-top: 3;
                    valign: center;
                    vexpand: true;
                    spacing: 10;

                    Adw.Spinner {
                        width-request: 36;
                    }

                    Label loading_label {
                        label: bind template.loading_label;
                    }
                };
            }
        }
    }
}

FileDialog open_file_dialog {
    modal: true;
    title: _("Open File");
    accept-label: _("Open");
}

FileDialog save_file_dialog {
    modal: true;
    title: _("Save File");
    accept-label: _("Save");
    initial-name: bind template.default_save_filename;
}
