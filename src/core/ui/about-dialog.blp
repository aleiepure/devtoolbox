using Gtk 4.0;
using Adw 1;

Adw.AboutDialog about_dialog {
    application-name: "Dev Toolbox";
    copyright: _("Copyright © 2022 - 2025 Alessandro Iepure\nSome icons are copyright of the GNOME Project");
    comments: _("Dev tools at your fingertips");
    website: "https://github.com/aleiepure/devtoolbox";
    issue-url: "https://github.com/aleiepure/devtoolbox/issues";
    application-icon: "me.iepure.devtoolbox";
    license-type: gpl_3_0;
    developer-name: "Alessandro Iepure";
    // TRANSLATORS: replace with your name (with optional email or website)
    translator-credits: _("translator-credits");
}
