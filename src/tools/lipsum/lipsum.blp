using Gtk 4.0;
using Adw 1;

template $LipsumWidget: Adw.Bin {
  Adw.ToastOverlay toast_overlay {
    child: ScrolledWindow {
      child: Adw.Clamp {
        vexpand: true;
        maximum-size: 1200;
        tightening-threshold: 600;

        child: Box {
          orientation: vertical;
          spacing: 12;
          margin-bottom: 12;
          margin-top: 12;

          // MARK: - Tool Settings
          Adw.PreferencesGroup {
            title: _("Options");

            Adw.SwitchRow begin_with_lorem_switchrow {
              title: _("Begin with 'Lorem ipsum dolor sit amet...'");
              active: true;
              icon-name: "headings";
              notify::active => $on_signal_notify_active_begin_with_lorem_switchrow() swapped;
            }

            Adw.ComboRow length_type_comborow {
              title: _("Length");
              icon-name: "stacked-plates";
              model: StringList {
                strings [
                  _("Words"),
                  _("Sentences"),
                  _("Paragraphs"),
                ]
              };
              notify::selected => $on_signal_notify_selected_length_type_comborow() swapped;

              [suffix]
              Adw.SpinRow length_spinrow {
                adjustment: Adjustment {
                  lower: 1;
                  upper: 1000;
                  step-increment: 1;
                  page-increment: 10;
                  value: 16;
                };
                notify::value => $on_signal_notify_value_length_spinrow() swapped;

                styles ["last-in-row"]
              }
            }
          }

          // MARK: - Tool Main Content
          Box {
            $TextArea output_area {
              title: _("Generated Text");
              copy-button-visible: true;
              editable: false;
              wrap-mode: "word";
              allow-drag-and-drop: false;
              error => $on_signal_error_output_area() swapped;
              monospace: true;
            }
          }
        };
      };
    };
  }
}
