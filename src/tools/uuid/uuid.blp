using Gtk 4.0;
using Adw 1;

template $UuidWidget : Adw.Bin {
  Adw.ToastOverlay toast_overlay {
    child: ScrolledWindow {
      child: Adw.Clamp {
        vexpand: true;
        maximum-size: 1200;
        tightening-threshold: 600;

        child: Box {
          orientation: vertical;
          spacing: 12;
          margin-bottom: 12;
          margin-top: 12;

          // MARK: - Tool Settings
          Adw.PreferencesGroup {
            title: _("Options");
            
            Adw.ComboRow version_comborow {
              title: _("Version");
              icon-name: "list-large";
              model: StringList {
                strings [
                  _("Version 1 (MAC Address)"),
                  _("Version 3"),
                  _("Version 4 (Random)"),
                  _("Version 5"),
                  _("Version 6 (Time-based)"),
                  _("Version 7 (Unix Epoch)"),
                ]
              };
              notify::selected => $on_signal_notify_selected_version_comborow() swapped;
            }

            Adw.SpinRow length_spinrow {
              title: _("Output Length");
              icon-name: "stacked-plates";
              adjustment: Adjustment {
                lower: 1;
                upper: 1000;
                step-increment: 1;
                page-increment: 10;
                value: 15;
              };
              notify::value => $on_signal_notify_value_length_spinrow() swapped;
            }
          }

          // MARK: - Tool Main Content
          Box {
            $TextArea output_area {
              title: _("Generated UUIDs");
              copy-button-visible: true;
              editable: false;
              wrap-mode: "word";
              monospace: true;
              show-line-numbers: true;
              highlight-current-line: true;
              allow-drag-and-drop: false;
              error => $on_signal_error_output_area() swapped;
            }
          }
        };
      };
    };
  }
}
