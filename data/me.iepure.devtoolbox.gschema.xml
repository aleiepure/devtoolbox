<schemalist gettext-domain="devtoolbox">
	<schema id="me.iepure.devtoolbox" path="/me/iepure/devtoolbox/">

		<!-- Window state -->
		<key name="window-width" type="i">
			<default>1200</default>
			<summary>Window width</summary>
		</key>
		<key name="window-height" type="i">
			<default>850</default>
			<summary>Window height</summary>
		</key>
		<key name="window-maximized" type="b">
			<default>false</default>
			<summary>Window maximized</summary>
		</key>
		<key name="last-tool" type="s">
			<choices>
				<choice value="config_format" />
				<choice value="timestamp" />
                <choice value="number_bases"/>
                <choice value="cron_parser"/>
                <choice value="cron_gen"/>
                <choice value="linux_permissions"/>
                <choice value="html_enc"/>
                <choice value="base64"/>
                <choice value="url_enc"/>
                <choice value="lipsum"/>
                <choice value="uuid"/>
                <choice value="random"/>
                <choice value="text_inspector"/>
			</choices>
			<summary>Last used tool</summary>
			<default>"config_format"</default>
		</key>
		<key name="sidebar-open" type="b">
			<summary>Sidebar open</summary>
			<default>true</default>
		</key>

		<!-- Favorites -->
		<key name="favorite-tools" type="as">
			<default>[]</default>
		</key>

		<!-- Settings -->
		<key name="color-scheme" type="s">
			<choices>
				<choice value="light" />
				<choice value="dark" />
				<choice value="system" />
			</choices>
			<default>"system"</default>
		</key>

		<!-- Color Converter -->
		<key name="color-converter-format" type="i">
			<default>0</default>
		</key>
		<key name="color-converter-bits" type="i">
			<default>8</default>
		</key>
		<key name="color-converter-angle" type="i">
			<default>0</default>
		</key>

	</schema>
</schemalist>